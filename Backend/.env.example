# Variables de entorno de la API. Defínelas en la terminal (local) o en la
# configuración del App Service (Azure). No subas valores reales al repositorio.
# Guía: docs/instalacion-local.md

# Django (obligatorias)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQL Server local. Sin DB_USER se usa autenticación de Windows.
DB_HOST=.
DB_PORT=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_USER=
DB_PASSWORD=
DB_NAME=AutoPartes
DW_DB_NAME=DWAutoPartes

# Usuarios de prueba (opcional; por defecto Demo.Europartes2026)
EUROPARTES_DEMO_PASSWORD=

# ETL: "ssisdb" en local (SSISDB de tu SQL Server), "adf" en Azure Data Factory
ETL_EJECUTOR=ssisdb

# MongoDB (opcional, autoevaluación de vendedores)
MONGODB_URI=
MONGODB_DB=europartes_autoevaluacion

# Azure Data Factory (solo en Azure)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_DATA_FACTORY_NAME=
AZURE_ETL_PIPELINE_NAME=

# Azure Synapse (opcional, resumen ejecutivo)
SYNAPSE_SQL_HOST=
SYNAPSE_DB_NAME=
