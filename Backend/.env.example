# Copia este archivo como variables de entorno del sistema o del App Service.
# No subas valores reales al repositorio.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Azure SQL (en local se usa SQL Server con autenticación de Windows)
DB_HOST=
DB_PORT=1433
DB_NAME=AutoPartes
DW_DB_NAME=DWAutoPartes

# MongoDB Atlas (autoevaluaciones)
MONGODB_URI=
MONGODB_DB=
MONGODB_TIMEOUT_MS=5000

# Azure Data Factory (ETL)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_DATA_FACTORY_NAME=
AZURE_ETL_PIPELINE_NAME=

# Azure Synapse (resumen ejecutivo, opcional)
SYNAPSE_SQL_HOST=
SYNAPSE_DB_NAME=
