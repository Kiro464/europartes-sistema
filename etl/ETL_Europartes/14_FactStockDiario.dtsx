            <component
              refId="Package\DFT - Construir FactStockDiario\SRC - Reconstruccion Stock Diario"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - Reconstruccion Stock Diario"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH Movimientos AS
(
    SELECT
        dp.ProductoID,
        ft.ProductoKey,
        dt.Fecha,
        ft.MovimientoInventarioID,
        dtm.TipoMovimientoCodigo,
        ft.Cantidad,
        ft.CantidadNeta,
        ft.StockAnterior,

        ROW_NUMBER() OVER
        (
            PARTITION BY dp.ProductoID
            ORDER BY dt.Fecha, ft.MovimientoInventarioID
        ) AS OrdenMovimiento

    FROM dbo.FactMovimientoInventario ft
    INNER JOIN dbo.DimProducto dp
        ON dp.ProductoKey = ft.ProductoKey
    INNER JOIN dbo.DimTiempo dt
        ON dt.TiempoKey = ft.FechaMovimientoKey
    INNER JOIN dbo.DimTipoMovimiento dtm
        ON dtm.TipoMovimientoKey = ft.TipoMovimientoKey
),
FechaCorte AS
(
    SELECT MAX(Fecha) AS FechaFin
    FROM Movimientos
),
StockInicialProducto AS
(
    SELECT
        m.ProductoID,
        m.Fecha AS FechaInicio,
        fc.FechaFin,
        m.StockAnterior AS StockInicialAncla
    FROM Movimientos m
    CROSS JOIN FechaCorte fc
    WHERE m.OrdenMovimiento = 1
),
Fechas AS
(
    SELECT DISTINCT
        Fecha
    FROM dbo.DimTiempo
),
Calendario AS
(
    SELECT
        sip.ProductoID,
        f.Fecha,
        sip.StockInicialAncla
    FROM StockInicialProducto sip
    INNER JOIN Fechas f
        ON f.Fecha &gt;= sip.FechaInicio
       AND f.Fecha &lt;= sip.FechaFin
),
MovimientosDia AS
(
    SELECT
        ProductoID,
        Fecha,

        SUM(
            CASE
                WHEN TipoMovimientoCodigo = 'ENTRADA_COMPRA'
                THEN Cantidad
                ELSE 0
            END
        ) AS Entradas,

        SUM(
            CASE
                WHEN TipoMovimientoCodigo = 'SALIDA_VENTA'
                THEN Cantidad
                ELSE 0
            END
        ) AS Salidas,

        SUM(
            CASE
                WHEN TipoMovimientoCodigo = 'AJUSTE'
                 AND CantidadNeta &gt; 0
                THEN CantidadNeta
                ELSE 0
            END
        ) AS AjustesPositivos,

        SUM(
            CASE
                WHEN TipoMovimientoCodigo = 'AJUSTE'
                 AND CantidadNeta &lt; 0
                THEN ABS(CantidadNeta)
                ELSE 0
            END
        ) AS AjustesNegativos,

        SUM(CantidadNeta) AS CantidadNeta

    FROM Movimientos
    GROUP BY
        ProductoID,
        Fecha
),
Base AS
(
    SELECT
        c.ProductoID,
        c.Fecha,
        c.StockInicialAncla,

        COALESCE(md.Entradas, 0) AS Entradas,
        COALESCE(md.Salidas, 0) AS Salidas,
        COALESCE(md.AjustesPositivos, 0) AS AjustesPositivos,
        COALESCE(md.AjustesNegativos, 0) AS AjustesNegativos,
        COALESCE(md.CantidadNeta, 0) AS CantidadNeta

    FROM Calendario c
    LEFT JOIN MovimientosDia md
        ON md.ProductoID = c.ProductoID
       AND md.Fecha = c.Fecha
),
Reconstruccion AS
(
    SELECT
        b.*,

        SUM(b.CantidadNeta) OVER
        (
            PARTITION BY b.ProductoID
            ORDER BY b.Fecha
            ROWS BETWEEN UNBOUNDED PRECEDING
                     AND CURRENT ROW
        ) AS VariacionAcumulada

    FROM Base b
)
SELECT
    dt.TiempoKey AS FechaKey,
    dp.ProductoKey,

    r.StockInicialAncla
        + r.VariacionAcumulada
        - r.CantidadNeta AS StockInicial,

    r.Entradas,
    r.Salidas,
    r.AjustesPositivos,
    r.AjustesNegativos,
    r.CantidadNeta,

    r.StockInicialAncla
        + r.VariacionAcumulada AS StockFinal
FROM Reconstruccion r
INNER JOIN dbo.DimTiempo dt
    ON dt.Fecha = r.Fecha
   AND dt.Hora = 0
   AND dt.Minuto = 0
INNER JOIN dbo.DimProducto dp
    ON dp.ProductoID = r.ProductoID
   AND dp.VigenteDesde &lt;= CAST(r.Fecha AS DATETIME2)
   AND (
        dp.VigenteHasta IS NULL
        OR CAST(r.Fecha AS DATETIME2) &lt; dp.VigenteHasta
   );</property>
