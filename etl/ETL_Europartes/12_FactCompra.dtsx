                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    dc.Id AS DetalleCompraID,
    c.Id AS CompraID,

    fc.Id AS FacturaCompraID,
    c.SolicitudCompraId AS SolicitudCompraID,

    c.Fecha AS FechaCompra,
    c.FechaRegistro AS FechaRegistro,
    c.FechaInicio,
    c.FechaAprobacion,
    c.FechaRecepcion,

    dc.ProductoId AS ProductoID,
    c.ProveedorId AS ProveedorID,

    c.EmpleadoId AS EmpleadoID,
    c.EmpleadoIniciadorId AS EmpleadoIniciadorID,
    c.EmpleadoAprobadorId AS EmpleadoAprobadorID,
    c.EmpleadoReceptorId AS EmpleadoReceptorID,

    CAST(c.Estado AS NVARCHAR(40)) AS EstadoCompra,

    dc.Cantidad,
    dc.CostoUnitario,

    CAST(dc.Cantidad * dc.CostoUnitario AS DECIMAL(12,2)) AS SubtotalDetalle,
    CAST(NULL AS DECIMAL(12,2)) AS IVADetalle,
    CAST(NULL AS DECIMAL(12,2)) AS TotalDetalle
FROM dbo.Compra c
INNER JOIN dbo.DetalleCompra dc
    ON dc.CompraId = c.Id
LEFT JOIN dbo.FacturaCompra fc
    ON fc.CompraId = c.Id;</property>
