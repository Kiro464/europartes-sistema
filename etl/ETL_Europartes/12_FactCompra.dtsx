            <component
              refId="Package\DFT - Cargar FactCompra\SRC - stg_FactCompra"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - stg_FactCompra"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    s.StgFactCompraKey,
    s.DetalleCompraID,
    s.CompraID,
    s.FacturaCompraID,
    s.SolicitudCompraID,

    -- Fechas de negocio normalizadas
    s.FechaCompra,
    s.FechaRegistro,
    s.FechaInicio,
    s.FechaAprobacion,
    s.FechaRecepcion,

    -- Claves DimTiempo
    dtc.TiempoKey AS FechaCompraKey,
    dtr.TiempoKey AS FechaRegistroKey,
    dti.TiempoKey AS FechaInicioKey,
    dta.TiempoKey AS FechaAprobacionKey,
    dtrc.TiempoKey AS FechaRecepcionKey,

    -- IDs de negocio
    s.ProductoID,
    s.ProveedorID,
    s.EmpleadoID,
    s.EmpleadoIniciadorID,
    s.EmpleadoAprobadorID,
    s.EmpleadoReceptorID,

    -- Dimensiones SCD2 y roles
    dp.ProductoKey,
    dpr.ProveedorKey,
    de.EmpleadoKey,
    dei.EmpleadoKey AS EmpleadoIniciadorKey,
    dea.EmpleadoKey AS EmpleadoAprobadorKey,
    der.EmpleadoKey AS EmpleadoReceptorKey,

    -- Atributos y métricas del hecho
    s.EstadoCompra,
    s.Cantidad,
    s.CostoUnitario,
    s.SubtotalDetalle,
    s.IVADetalle,
    s.TotalDetalle,

    -- Indicadores de resolución obligatorios
    CASE WHEN dtc.TiempoKey IS NULL THEN 1 ELSE 0 END AS FaltaFechaCompra,
    CASE WHEN dtr.TiempoKey IS NULL THEN 1 ELSE 0 END AS FaltaFechaRegistro,
    CASE WHEN dp.ProductoKey IS NULL THEN 1 ELSE 0 END AS FaltaProducto,
    CASE WHEN dpr.ProveedorKey IS NULL THEN 1 ELSE 0 END AS FaltaProveedor,
    CASE WHEN de.EmpleadoKey IS NULL THEN 1 ELSE 0 END AS FaltaEmpleado,

    -- Indicadores de resolución opcionales (sólo es falta si el ID/Fecha existe pero no resuelve)
    CASE WHEN s.FechaInicio IS NOT NULL AND dti.TiempoKey IS NULL THEN 1 ELSE 0 END AS FaltaFechaInicio,
    CASE WHEN s.FechaAprobacion IS NOT NULL AND dta.TiempoKey IS NULL THEN 1 ELSE 0 END AS FaltaFechaAprobacion,
    CASE WHEN s.FechaRecepcion IS NOT NULL AND dtrc.TiempoKey IS NULL THEN 1 ELSE 0 END AS FaltaFechaRecepcion,
    CASE WHEN s.EmpleadoIniciadorID IS NOT NULL AND dei.EmpleadoKey IS NULL THEN 1 ELSE 0 END AS FaltaEmpleadoIniciador,
    CASE WHEN s.EmpleadoAprobadorID IS NOT NULL AND dea.EmpleadoKey IS NULL THEN 1 ELSE 0 END AS FaltaEmpleadoAprobador,
    CASE WHEN s.EmpleadoReceptorID IS NOT NULL AND der.EmpleadoKey IS NULL THEN 1 ELSE 0 END AS FaltaEmpleadoReceptor,

    -- Indicador global de rechazo
    CASE
        WHEN dtc.TiempoKey IS NULL
          OR dtr.TiempoKey IS NULL
          OR dp.ProductoKey IS NULL
          OR dpr.ProveedorKey IS NULL
          OR de.EmpleadoKey IS NULL
          OR (s.FechaInicio IS NOT NULL AND dti.TiempoKey IS NULL)
          OR (s.FechaAprobacion IS NOT NULL AND dta.TiempoKey IS NULL)
          OR (s.FechaRecepcion IS NOT NULL AND dtrc.TiempoKey IS NULL)
          OR (s.EmpleadoIniciadorID IS NOT NULL AND dei.EmpleadoKey IS NULL)
          OR (s.EmpleadoAprobadorID IS NOT NULL AND dea.EmpleadoKey IS NULL)
          OR (s.EmpleadoReceptorID IS NOT NULL AND der.EmpleadoKey IS NULL)
        THEN 1
        ELSE 0
    END AS RegistroRechazado

FROM stg.FactCompra s
-- =========================================================
-- DimTiempo (5 marcas temporales)
-- =========================================================
LEFT JOIN dbo.DimTiempo dtc
    ON dtc.FechaHora = s.FechaCompra
LEFT JOIN dbo.DimTiempo dtr
    ON dtr.FechaHora = s.FechaRegistro
LEFT JOIN dbo.DimTiempo dti
    ON dti.FechaHora = s.FechaInicio
LEFT JOIN dbo.DimTiempo dta
    ON dta.FechaHora = s.FechaAprobacion
LEFT JOIN dbo.DimTiempo dtrc
    ON dtrc.FechaHora = s.FechaRecepcion
-- =========================================================
-- DimProducto - SCD2 (vigencia referenciada a FechaCompra)
-- =========================================================
LEFT JOIN dbo.DimProducto dp
    ON dp.ProductoID = s.ProductoID
    AND dp.VigenteDesde &lt;= s.FechaCompra
    AND (
        dp.VigenteHasta IS NULL
        OR s.FechaCompra &lt; dp.VigenteHasta
    )
-- =========================================================
-- DimProveedor - SCD2 (vigencia referenciada a FechaCompra)
-- =========================================================
LEFT JOIN dbo.DimProveedor dpr
    ON dpr.ProveedorID = s.ProveedorID
    AND dpr.VigenteDesde &lt;= s.FechaCompra
    AND (
        dpr.VigenteHasta IS NULL
        OR s.FechaCompra &lt; dpr.VigenteHasta
    )
-- =========================================================
-- DimEmpleado - Principal (SCD2 referenciada a FechaCompra)
-- =========================================================
LEFT JOIN dbo.DimEmpleado de
    ON de.EmpleadoID = s.EmpleadoID
    AND de.VigenteDesde &lt;= s.FechaCompra
    AND (
        de.VigenteHasta IS NULL
        OR s.FechaCompra &lt; de.VigenteHasta
    )
-- =========================================================
-- DimEmpleado - Iniciador (SCD2 referenciada a FechaCompra)
-- =========================================================
LEFT JOIN dbo.DimEmpleado dei
    ON dei.EmpleadoID = s.EmpleadoIniciadorID
    AND dei.VigenteDesde &lt;= s.FechaCompra
    AND (
        dei.VigenteHasta IS NULL
        OR s.FechaCompra &lt; dei.VigenteHasta
    )
-- =========================================================
-- DimEmpleado - Aprobador (SCD2 referenciada a FechaAprobacion)
-- =========================================================
LEFT JOIN dbo.DimEmpleado dea
    ON dea.EmpleadoID = s.EmpleadoAprobadorID
    AND dea.VigenteDesde &lt;= s.FechaAprobacion
    AND (
        dea.VigenteHasta IS NULL
        OR s.FechaAprobacion &lt; dea.VigenteHasta
    )
-- =========================================================
-- DimEmpleado - Receptor (SCD2 referenciada a FechaRecepcion)
-- =========================================================
LEFT JOIN dbo.DimEmpleado der
    ON der.EmpleadoID = s.EmpleadoReceptorID
    AND der.VigenteDesde &lt;= s.FechaRecepcion
    AND (
        der.VigenteHasta IS NULL
        OR s.FechaRecepcion &lt; der.VigenteHasta
    )
WHERE s.EjecucionKey = ?;</property>
