          SQLTask:SqlStatementSource="UPDATE dbo.ETL_ControlCarga&#xA;SET&#xA;    UltimaFechaCarga = SYSDATETIME(),&#xA;    UltimoIDCarga = (&#xA;        SELECT MAX(DetalleCompraID)&#xA;        FROM dbo.FactCompra&#xA;    ),&#xA;    UltimaEjecucionKey = ?,&#xA;    FechaActualizacion = SYSDATETIME()&#xA;WHERE Entidad = 'FactCompra';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
