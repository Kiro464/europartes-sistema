                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    s.Id AS SolicitudCompraID,
    d.Id AS DetalleSolicitudCompraID,

    s.FechaSolicitud,
    s.FechaRegistro,
    s.FechaRespuesta,

    d.ProductoId AS ProductoID,

    s.EmpleadoId AS EmpleadoID,
    s.EmpleadoRespuestaId AS EmpleadoRespuestaID,

    s.Estado AS EstadoSolicitud,
    d.Cantidad AS CantidadSolicitada,
    s.Observaciones

FROM dbo.SolicitudCompra s
INNER JOIN dbo.DetalleSolicitudCompra d
    ON d.SolicitudCompraId = s.Id;</property>
