            <component
              refId="Package\DFT - Cargar FactSolicitudCompra\SRC - stg_FactSolicitudCompra"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - stg_FactSolicitudCompra"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    s.StgFactSolicitudCompraKey,

    s.SolicitudCompraID,
    s.DetalleSolicitudCompraID,

    s.FechaSolicitud,
    s.FechaRegistro,
    s.FechaRespuesta,

    -- DimTiempo
    dts.TiempoKey AS FechaSolicitudKey,
    dtr.TiempoKey AS FechaRegistroKey,
    dtrsp.TiempoKey AS FechaRespuestaKey,

    -- IDs de negocio
    s.ProductoID,
    s.EmpleadoID,
    s.EmpleadoRespuestaID,

    -- Dimensiones SCD2
    dp.ProductoKey,
    de.EmpleadoKey,
    der.EmpleadoKey AS EmpleadoRespuestaKey,

    -- Atributos del hecho
    s.EstadoSolicitud,
    s.CantidadSolicitada,

    -- Indicadores de resolución
    CASE
        WHEN dts.TiempoKey IS NULL THEN 1
        ELSE 0
    END AS FaltaFechaSolicitud,

    CASE
        WHEN dtr.TiempoKey IS NULL THEN 1
        ELSE 0
    END AS FaltaFechaRegistro,

    CASE
        WHEN s.FechaRespuesta IS NOT NULL
         AND dtrsp.TiempoKey IS NULL
        THEN 1
        ELSE 0
    END AS FaltaFechaRespuesta,

    CASE
        WHEN dp.ProductoKey IS NULL THEN 1
        ELSE 0
    END AS FaltaProducto,

    CASE
        WHEN de.EmpleadoKey IS NULL THEN 1
        ELSE 0
    END AS FaltaEmpleado,

    CASE
        WHEN s.EmpleadoRespuestaID IS NOT NULL
         AND der.EmpleadoKey IS NULL
        THEN 1
        ELSE 0
    END AS FaltaEmpleadoRespuesta,

    CASE
        WHEN dts.TiempoKey IS NULL
          OR dtr.TiempoKey IS NULL
          OR dp.ProductoKey IS NULL
          OR de.EmpleadoKey IS NULL
          OR (
                s.FechaRespuesta IS NOT NULL
                AND dtrsp.TiempoKey IS NULL
             )
          OR (
                s.EmpleadoRespuestaID IS NOT NULL
                AND der.EmpleadoKey IS NULL
             )
        THEN 1
        ELSE 0
    END AS RegistroRechazado

FROM stg.FactSolicitudCompra s

-- =========================================================
-- DimTiempo
-- =========================================================

LEFT JOIN dbo.DimTiempo dts
    ON dts.FechaHora = s.FechaSolicitud

LEFT JOIN dbo.DimTiempo dtr
    ON dtr.FechaHora = s.FechaRegistro

LEFT JOIN dbo.DimTiempo dtrsp
    ON dtrsp.FechaHora = s.FechaRespuesta

-- =========================================================
-- DimProducto - SCD2
-- =========================================================

LEFT JOIN dbo.DimProducto dp
    ON dp.ProductoID = s.ProductoID
    AND dp.VigenteDesde &lt;= s.FechaSolicitud
    AND (
        dp.VigenteHasta IS NULL
        OR s.FechaSolicitud &lt; dp.VigenteHasta
    )

-- =========================================================
-- DimEmpleado - solicitante - SCD2
-- =========================================================

LEFT JOIN dbo.DimEmpleado de
    ON de.EmpleadoID = s.EmpleadoID
    AND de.VigenteDesde &lt;= s.FechaSolicitud
    AND (
        de.VigenteHasta IS NULL
        OR s.FechaSolicitud &lt; de.VigenteHasta
    )

-- =========================================================
-- DimEmpleado - respondiente - SCD2
-- =========================================================

LEFT JOIN dbo.DimEmpleado der
    ON der.EmpleadoID = s.EmpleadoRespuestaID
    AND der.VigenteDesde &lt;= s.FechaRespuesta
    AND (
        der.VigenteHasta IS NULL
        OR s.FechaRespuesta &lt; der.VigenteHasta
    )

WHERE s.EjecucionKey = ?;</property>
