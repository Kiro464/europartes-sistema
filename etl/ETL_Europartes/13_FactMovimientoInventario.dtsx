          SQLTask:SqlStatementSource="UPDATE dbo.ETL_ControlCarga&#xA;SET&#xA;    UltimaFechaCarga = SYSDATETIME(),&#xA;    UltimoIDCarga = (&#xA;        SELECT MAX(MovimientoInventarioID)&#xA;        FROM dbo.FactMovimientoInventario&#xA;    ),&#xA;    UltimaEjecucionKey = ?,&#xA;    FechaActualizacion = SYSDATETIME()&#xA;WHERE Entidad = 'FactMovimientoInventario';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
