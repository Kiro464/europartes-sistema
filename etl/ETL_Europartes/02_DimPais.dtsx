          SQLTask:SqlStatementSource="UPDATE dbo.ETL_Ejecucion&#xA;SET&#xA;    RegistrosExtraidos = RegistrosExtraidos + ?,&#xA;    RegistrosInsertados = RegistrosInsertados + ?,&#xA;    RegistrosActualizados = RegistrosActualizados + ?,&#xA;    RegistrosRechazados = RegistrosRechazados + ?,&#xA;    Mensaje = COALESCE(Mensaje, '') + ' | DimPais procesada correctamente'&#xA;WHERE EjecucionKey = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
