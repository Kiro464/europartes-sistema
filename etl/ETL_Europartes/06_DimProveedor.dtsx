    <DTS:Executable
      DTS:refId="Package\SQL - Actualizar Control DimProveedor"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{1120A2EC-13C4-4851-8149-B6355300E148}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Actualizar Control DimProveedor"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F0E051A-1F1C-413F-84A1-1CEACCF5AABA}"
          SQLTask:SqlStatementSource="UPDATE dbo.ETL_ControlCarga&#xA;SET&#xA;    UltimaFechaCarga = SYSDATETIME(),&#xA;    UltimoIDCarga = (SELECT MAX(ProveedorID) FROM dbo.DimProveedor),&#xA;    UltimaEjecucionKey = ?,&#xA;    FechaActualizacion = SYSDATETIME()&#xA;WHERE Entidad = 'DimProveedor';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::EjecucionKey"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Clasificar y Aplicar SCD2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{671DEFF2-B4EA-4752-900D-25B5983A5853}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Clasificar y Aplicar SCD2"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F0E051A-1F1C-413F-84A1-1CEACCF5AABA}"
          SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#xA;BEGIN TRY&#xA;&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    DECLARE @EjecucionKey BIGINT = ?;&#xA;    DECLARE @FechaCarga DATETIME2(0);&#xA;&#xA;    SELECT&#xA;        @FechaCarga = CAST(FechaInicio AS DATETIME2(0))&#xA;    FROM dbo.ETL_Ejecucion&#xA;    WHERE EjecucionKey = @EjecucionKey;&#xA;&#xA;    /* --- PROTECCIÓN 1: Validar existencia de la ejecución --- */&#xA;    IF @FechaCarga IS NULL&#xA;        THROW 50001, 'No se encontro la ejecucion ETL indicada.', 1;&#xA;&#xA;    /* --- PROTECCIÓN 2: Validar datos en Staging --- */&#xA;    IF NOT EXISTS (&#xA;        SELECT 1&#xA;        FROM stg.Proveedor&#xA;        WHERE EjecucionKey = @EjecucionKey&#xA;    )&#xA;        THROW 50002, 'No existen registros en staging para la ejecucion ETL.', 1;&#xA;&#xA;    /* ============================================================&#xA;       1. CLASIFICAR REGISTROS&#xA;       ============================================================ */&#xA;    IF OBJECT_ID('tempdb..#ClasificacionProveedor') IS NOT NULL&#xA;        DROP TABLE #ClasificacionProveedor;&#xA;&#xA;    SELECT&#xA;        s.StgProveedorKey,&#xA;        s.ProveedorID,&#xA;        s.Nombre,&#xA;        s.PaisKey,&#xA;        s.Telefono,&#xA;        s.Email,&#xA;        s.SitioWeb,&#xA;        s.Estado,&#xA;        s.FechaCarga,&#xA;        CASE&#xA;            WHEN d.ProveedorKey IS NULL&#xA;                THEN 'NUEVO'&#xA;&#xA;            WHEN&#xA;                d.Nombre &lt;&gt; s.Nombre&#xA;                OR (d.Nombre IS NULL AND s.Nombre IS NOT NULL)&#xA;                OR (d.Nombre IS NOT NULL AND s.Nombre IS NULL)&#xA;&#xA;                OR d.PaisKey &lt;&gt; s.PaisKey&#xA;                OR (d.PaisKey IS NULL AND s.PaisKey IS NOT NULL)&#xA;                OR (d.PaisKey IS NOT NULL AND s.PaisKey IS NULL)&#xA;&#xA;                OR d.Telefono &lt;&gt; s.Telefono&#xA;                OR (d.Telefono IS NULL AND s.Telefono IS NOT NULL)&#xA;                OR (d.Telefono IS NOT NULL AND s.Telefono IS NULL)&#xA;&#xA;                OR d.Email &lt;&gt; s.Email&#xA;                OR (d.Email IS NULL AND s.Email IS NOT NULL)&#xA;                OR (d.Email IS NOT NULL AND s.Email IS NULL)&#xA;&#xA;                OR d.SitioWeb &lt;&gt; s.SitioWeb&#xA;                OR (d.SitioWeb IS NULL AND s.SitioWeb IS NOT NULL)&#xA;                OR (d.SitioWeb IS NOT NULL AND s.SitioWeb IS NULL)&#xA;&#xA;                OR d.Estado &lt;&gt; s.Estado&#xA;                THEN 'CAMBIO'&#xA;&#xA;            ELSE 'SIN_CAMBIO'&#xA;        END AS TipoOperacion&#xA;    INTO #ClasificacionProveedor&#xA;    FROM stg.Proveedor s&#xA;    LEFT JOIN dbo.DimProveedor d&#xA;        ON d.ProveedorID = s.ProveedorID&#xA;        AND d.EsActual = 1&#xA;    WHERE&#xA;        s.EjecucionKey = @EjecucionKey;&#xA;&#xA;    /* ============================================================&#xA;       2. CERRAR VERSIONES ACTUALES MODIFICADAS&#xA;       ============================================================ */&#xA;    UPDATE d&#xA;    SET&#xA;        d.EsActual = 0,&#xA;        d.VigenteHasta = c.FechaCarga&#xA;    FROM dbo.DimProveedor d&#xA;    INNER JOIN #ClasificacionProveedor c&#xA;        ON c.ProveedorID = d.ProveedorID&#xA;    WHERE&#xA;        c.TipoOperacion = 'CAMBIO'&#xA;        AND d.EsActual = 1;&#xA;&#xA;    /* ============================================================&#xA;       3. INSERTAR NUEVOS Y NUEVAS VERSIONES SCD2&#xA;       ============================================================ */&#xA;    INSERT INTO dbo.DimProveedor&#xA;    (&#xA;        ProveedorID,&#xA;        Nombre,&#xA;        PaisKey,&#xA;        Telefono,&#xA;        Email,&#xA;        SitioWeb,&#xA;        Estado,&#xA;        VigenteDesde,&#xA;        VigenteHasta,&#xA;        EsActual&#xA;    )&#xA;    SELECT&#xA;        ProveedorID,&#xA;        Nombre,&#xA;        PaisKey,&#xA;        Telefono,&#xA;        Email,&#xA;        SitioWeb,&#xA;        Estado,&#xA;        FechaCarga,&#xA;        NULL,&#xA;        1&#xA;    FROM #ClasificacionProveedor&#xA;    WHERE TipoOperacion IN ('NUEVO', 'CAMBIO');&#xA;&#xA;    /* ============================================================&#xA;       4. COMMIT&#xA;       ============================================================ */&#xA;    COMMIT TRANSACTION;&#xA;&#xA;    /* ============================================================&#xA;       5. DEVOLVER CONTADORES A SSIS&#xA;       ============================================================ */&#xA;    SELECT&#xA;        CAST(SUM(CASE WHEN TipoOperacion IN ('NUEVO') THEN 1 ELSE 0 END) AS INT)&#xA;            AS RegistrosInsertados,&#xA;        CAST(SUM(CASE WHEN TipoOperacion = 'CAMBIO' THEN 1 ELSE 0 END) AS INT)&#xA;            AS RegistrosActualizados,&#xA;        CAST(SUM(CASE WHEN TipoOperacion = 'SIN_CAMBIO' THEN 1 ELSE 0 END) AS INT)&#xA;            AS RegistrosSinCambio&#xA;    FROM #ClasificacionProveedor;&#xA;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;    THROW;&#xA;END CATCH;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RegistrosInsertados"
            SQLTask:DtsVariableName="User::RegistrosInsertados" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="RegistrosActualizados"
            SQLTask:DtsVariableName="User::RegistrosActualizados" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="RegistrosSinCambio"
            SQLTask:DtsVariableName="User::RegistrosSinCambio" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::EjecucionKey"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
