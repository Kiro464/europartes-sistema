            <component
              refId="Package\DFT - Cargar FactVenta\SRC - stg_FactVenta"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - stg_FactVenta"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    s.StgFactVentaKey,
    s.DetalleVentaID,
    s.VentaID,
    s.FacturaVentaID,

    -- Fechas originales de staging
    s.FechaVenta,
    s.FechaRegistro,

    -- Claves sustitutas de DimTiempo
    dtv.TiempoKey AS FechaVentaKey,
    dtr.TiempoKey AS FechaRegistroKey,

    -- IDs de negocio
    s.ProductoID,
    s.ClienteID,
    s.EmpleadoID,

    -- Claves sustitutas SCD2
    dp.ProductoKey,
    dc.ClienteKey,
    de.EmpleadoKey,

    -- Métricas
    s.Cantidad,
    s.PrecioUnitario,
    s.SubtotalDetalle AS Subtotal,
    s.IVADetalle AS IVA,
    s.TotalDetalle AS Total,

    -- Indicadores de resolución
    CASE
        WHEN dtv.TiempoKey IS NULL THEN 1
        ELSE 0
    END AS FaltaFechaVenta,

    CASE
        WHEN dtr.TiempoKey IS NULL THEN 1
        ELSE 0
    END AS FaltaFechaRegistro,

    CASE
        WHEN dp.ProductoKey IS NULL THEN 1
        ELSE 0
    END AS FaltaProducto,

    CASE
        WHEN dc.ClienteKey IS NULL THEN 1
        ELSE 0
    END AS FaltaCliente,

    CASE
        WHEN de.EmpleadoKey IS NULL THEN 1
        ELSE 0
    END AS FaltaEmpleado,

    CASE
        WHEN dtv.TiempoKey IS NULL
          OR dtr.TiempoKey IS NULL
          OR dp.ProductoKey IS NULL
          OR dc.ClienteKey IS NULL
          OR de.EmpleadoKey IS NULL
        THEN 1
        ELSE 0
    END AS RegistroRechazado
FROM stg.FactVenta s
-- DimTiempo: coincidencia exacta
LEFT JOIN dbo.DimTiempo dtv
    ON dtv.FechaHora = s.FechaVenta
LEFT JOIN dbo.DimTiempo dtr
    ON dtr.FechaHora = s.FechaRegistro
-- DimProducto: SCD2 temporal respecto a FechaVenta
LEFT JOIN dbo.DimProducto dp
    ON dp.ProductoID = s.ProductoID
    AND dp.VigenteDesde &lt;= s.FechaVenta
    AND (
        dp.VigenteHasta IS NULL
        OR s.FechaVenta &lt; dp.VigenteHasta
    )
-- DimCliente: SCD2 temporal respecto a FechaVenta
LEFT JOIN dbo.DimCliente dc
    ON dc.ClienteID = s.ClienteID
    AND dc.VigenteDesde &lt;= s.FechaVenta
    AND (
        dc.VigenteHasta IS NULL
        OR s.FechaVenta &lt; dc.VigenteHasta
    )
-- DimEmpleado: SCD2 temporal respecto a FechaVenta
LEFT JOIN dbo.DimEmpleado de
    ON de.EmpleadoID = s.EmpleadoID
    AND de.VigenteDesde &lt;= s.FechaVenta
    AND (
        de.VigenteHasta IS NULL
        OR s.FechaVenta &lt; de.VigenteHasta
    )
WHERE s.EjecucionKey = ?;</property>
