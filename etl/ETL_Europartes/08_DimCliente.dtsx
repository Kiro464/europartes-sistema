    <DTS:Executable
      DTS:refId="Package\SQL - Actualizar Control"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{8E450897-2A05-483E-BD4D-53FAB3E5333D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Actualizar Control"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F0E051A-1F1C-413F-84A1-1CEACCF5AABA}"
          SQLTask:SqlStatementSource="UPDATE dbo.ETL_ControlCarga&#xA;SET&#xA;    UltimaFechaCarga = SYSDATETIME(),&#xA;    UltimoIDCarga = (&#xA;        SELECT MAX(ClienteID)&#xA;        FROM dbo.DimCliente&#xA;        WHERE EsActual = 1&#xA;    ),&#xA;    UltimaEjecucionKey = ?,&#xA;    FechaActualizacion = SYSDATETIME()&#xA;WHERE Entidad = 'DimCliente';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::EjecucionKey"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Clasificar y Aplicar SCD2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{51920598-62BB-4455-8F54-F999DC5FCCC4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Clasificar y Aplicar SCD2"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F0E051A-1F1C-413F-84A1-1CEACCF5AABA}"
          SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;DECLARE @EjecucionKey BIGINT = ?;&#xA;DECLARE @FechaCarga DATETIME2(0);&#xA;&#xA;SELECT&#xA;    @FechaCarga = FechaInicio&#xA;FROM dbo.ETL_Ejecucion&#xA;WHERE EjecucionKey = @EjecucionKey;&#xA;&#xA;IF @FechaCarga IS NULL&#xA;BEGIN&#xA;    THROW 50001, 'No se encontro la ejecucion ETL indicada.', 1;&#xA;END;&#xA;&#xA;IF NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM stg.Cliente&#xA;    WHERE EjecucionKey = @EjecucionKey&#xA;)&#xA;BEGIN&#xA;    THROW 50002, 'No existen registros en staging para la ejecucion ETL.', 1;&#xA;END;&#xA;&#xA;BEGIN TRY&#xA;&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    IF OBJECT_ID('tempdb..#ClasificacionCliente') IS NOT NULL&#xA;        DROP TABLE #ClasificacionCliente;&#xA;&#xA;    SELECT&#xA;        s.StgClienteKey,&#xA;        s.ClienteID,&#xA;        s.Nombres,&#xA;        s.Apellidos,&#xA;        s.Telefono,&#xA;        s.Direccion,&#xA;        s.Correo,&#xA;        s.Estado,&#xA;        s.FechaCarga,&#xA;&#xA;        CASE&#xA;            WHEN d.ClienteKey IS NULL&#xA;                THEN 'NUEVO'&#xA;&#xA;            WHEN&#xA;                ISNULL(d.Nombres, '') &lt;&gt; ISNULL(s.Nombres, '')&#xA;                OR ISNULL(d.Apellidos, '') &lt;&gt; ISNULL(s.Apellidos, '')&#xA;                OR ISNULL(d.Telefono, '') &lt;&gt; ISNULL(s.Telefono, '')&#xA;                OR ISNULL(d.Direccion, '') &lt;&gt; ISNULL(s.Direccion, '')&#xA;                OR ISNULL(d.Correo, '') &lt;&gt; ISNULL(s.Correo, '')&#xA;                OR ISNULL(d.Estado, 0) &lt;&gt; ISNULL(s.Estado, 0)&#xA;                THEN 'CAMBIO'&#xA;&#xA;            ELSE 'SIN_CAMBIO'&#xA;        END AS TipoCambio&#xA;&#xA;    INTO #ClasificacionCliente&#xA;&#xA;    FROM stg.Cliente s&#xA;&#xA;    LEFT JOIN dbo.DimCliente d&#xA;        ON d.ClienteID = s.ClienteID&#xA;       AND d.EsActual = 1&#xA;&#xA;    WHERE s.EjecucionKey = @EjecucionKey;&#xA;&#xA;&#xA;    UPDATE d&#xA;    SET&#xA;        d.EsActual = 0,&#xA;        d.VigenteHasta = @FechaCarga&#xA;&#xA;    FROM dbo.DimCliente d&#xA;&#xA;    INNER JOIN #ClasificacionCliente c&#xA;        ON c.ClienteID = d.ClienteID&#xA;       AND c.TipoCambio = 'CAMBIO'&#xA;&#xA;    WHERE d.EsActual = 1;&#xA;&#xA;&#xA;    INSERT INTO dbo.DimCliente&#xA;    (&#xA;        ClienteID,&#xA;        Nombres,&#xA;        Apellidos,&#xA;        Telefono,&#xA;        Direccion,&#xA;        Correo,&#xA;        Estado,&#xA;        VigenteDesde,&#xA;        VigenteHasta,&#xA;        EsActual&#xA;    )&#xA;&#xA;    SELECT&#xA;        ClienteID,&#xA;        Nombres,&#xA;        Apellidos,&#xA;        Telefono,&#xA;        Direccion,&#xA;        Correo,&#xA;        Estado,&#xA;        @FechaCarga,&#xA;        NULL,&#xA;        1&#xA;&#xA;    FROM #ClasificacionCliente&#xA;&#xA;    WHERE TipoCambio IN ('NUEVO', 'CAMBIO');&#xA;&#xA;&#xA;    COMMIT;&#xA;&#xA;&#xA;    SELECT&#xA;        SUM(&#xA;            CASE&#xA;                WHEN TipoCambio = 'NUEVO' THEN 1&#xA;                ELSE 0&#xA;            END&#xA;        ) AS RegistrosInsertados,&#xA;&#xA;        SUM(&#xA;            CASE&#xA;                WHEN TipoCambio = 'CAMBIO' THEN 1&#xA;                ELSE 0&#xA;            END&#xA;        ) AS RegistrosActualizados,&#xA;&#xA;        SUM(&#xA;            CASE&#xA;                WHEN TipoCambio = 'SIN_CAMBIO' THEN 1&#xA;                ELSE 0&#xA;            END&#xA;        ) AS RegistrosSinCambio&#xA;&#xA;    FROM #ClasificacionCliente;&#xA;&#xA;END TRY&#xA;&#xA;BEGIN CATCH&#xA;&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK;&#xA;&#xA;    THROW;&#xA;&#xA;END CATCH;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RegistrosInsertados"
            SQLTask:DtsVariableName="User::RegistrosInsertados" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="RegistrosActualizados"
            SQLTask:DtsVariableName="User::RegistrosActualizados" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="RegistrosSinCambio"
            SQLTask:DtsVariableName="User::RegistrosSinCambio" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::EjecucionKey"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
