        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F0E051A-1F1C-413F-84A1-1CEACCF5AABA}"
          SQLTask:SqlStatementSource="UPDATE dbo.ETL_ControlCarga&#xA;SET&#xA;    UltimaFechaCarga = SYSDATETIME(),&#xA;    UltimoIDCarga = (SELECT MAX(MarcaID) FROM dbo.DimMarca),&#xA;    UltimaEjecucionKey = ?,&#xA;    FechaActualizacion = SYSDATETIME()&#xA;WHERE Entidad = 'DimMarca';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
