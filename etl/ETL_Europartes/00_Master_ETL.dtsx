    <DTS:Executable
      DTS:refId="Package\SQL - Finalizar Ejecucion EXITOSA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{37A4E369-C11A-4A61-80D7-09FC1C51CFA6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Finalizar Ejecucion EXITOSA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F0E051A-1F1C-413F-84A1-1CEACCF5AABA}"
          SQLTask:SqlStatementSource="UPDATE dbo.ETL_Ejecucion&#xA;SET&#xA;    FechaFin = SYSDATETIME(),&#xA;    Estado = 'EXITOSA',&#xA;    Mensaje = COALESCE(Mensaje, '') +&#xA;              ' | Ejecucion ETL finalizada correctamente'&#xA;WHERE EjecucionKey = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::EjecucionKey"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Finalizar Ejecucion FALLIDA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{095CEBCB-A896-4FF8-9535-9580BF6BA2BC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Finalizar Ejecucion FALLIDA"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F0E051A-1F1C-413F-84A1-1CEACCF5AABA}"
          SQLTask:SqlStatementSource="UPDATE dbo.ETL_Ejecucion&#xA;SET&#xA;    FechaFin = SYSDATETIME(),&#xA;    Estado = 'FALLIDA',&#xA;    Mensaje = COALESCE(Mensaje, '') + ' | Ejecucion ETL finalizada con errores'&#xA;WHERE EjecucionKey = ?;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::EjecucionKey"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Iniciar Ejecucion ETL"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{9EC39888-5114-4240-9CB1-730B5A54376D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Iniciar Ejecucion ETL"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4F0E051A-1F1C-413F-84A1-1CEACCF5AABA}"
          SQLTask:SqlStatementSource="DECLARE @pKey BIGINT = ?;&#xA;&#xA;IF @pKey &gt; 0&#xA;BEGIN&#xA;    -- Ejecución orquestada por Django: reutiliza la clave generada por el backend&#xA;    SELECT @pKey AS EjecucionKey;&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    -- Ejecución manual desde SSDT: genera una nueva clave en el DW&#xA;    INSERT INTO dbo.ETL_Ejecucion&#xA;    (&#xA;        Paquete,&#xA;        FechaInicio,&#xA;        Estado,&#xA;        RegistrosExtraidos,&#xA;        RegistrosInsertados,&#xA;        RegistrosActualizados,&#xA;        RegistrosRechazados,&#xA;        Mensaje&#xA;    )&#xA;    VALUES&#xA;    (&#xA;        '00_Master_ETL',&#xA;        SYSDATETIME(),&#xA;        'INICIADA',&#xA;        0, 0, 0, 0,&#xA;        'Inicio de ejecucion ETL (Manual Visual Studio)'&#xA;    );&#xA;&#xA;    SELECT CAST(SCOPE_IDENTITY() AS BIGINT) AS EjecucionKey;&#xA;END"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="EjecucionKey"
            SQLTask:DtsVariableName="User::EjecucionKey" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Package::pEjecucionKey"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="20"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
